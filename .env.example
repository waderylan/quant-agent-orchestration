# Configuration scaffold; no application environment loader is implemented.
# Deployment generation: Nebius Token Factory selected; NVIDIA-hosted NIM tentative.
# Exact model IDs, access, routing, and endpoint integration remain unverified.
NEBIUS_API_KEY=
NEBIUS_MODEL=
NEBIUS_BASE_URL=


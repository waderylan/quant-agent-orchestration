# codex: authenticated local CLI. api: direct NVIDIA/Nebius routing.
# Keys alone never enable paid generation. See README provider setup.
GENERATION_PROFILE=codex
RESEARCH_MODEL=gpt-6.1-sol
# Whole-request decomposition and independent answer review are enabled by default.
REQUEST_PLANNER=semantic
# REQUEST_PLANNER=rules is a deterministic regression profile without model planning/review.
# Optional authenticated host bridge for local Docker; leave unset for native CLI.
# CODEX_BRIDGE_URL=tcp://host.docker.internal:8765
# CODEX_BRIDGE_TOKEN_FILE=/run/secrets/codex-bridge
# Reingest/restart after changing source coverage. Keep generated data ignored.
SOURCE_CORPUS=data/corpus
RESEARCH_INDEX_DIR=chroma_index
FINANCIAL_DATA_DIR=data/financials
QUANT_ARTIFACT_DIR=artifacts/quant

# Tavily Remote MCP. Set the key to enable live mode by default.
# LIVE_MODE=live
LIVE_CACHE=artifacts/live/cache
LIVE_LEDGER=artifacts/live/usage.sqlite3

# Initialize the shared ledger from verified dashboard credit before Nebius use.
PROVIDER_LEDGER=artifacts/providers/usage.sqlite3
NEBIUS_CAMPAIGN_USD=5
NEBIUS_API_KEY=
NVIDIA_API_KEY=
TAVILY_API_KEY=
# The ledger above is local test tooling, not an assignment/deployment requirement.
# Cloud Run API generation is gated pending a separate production spending policy.
GCP_PROJECT_ID=
GCP_REGION=
CLOUD_RUN_SERVICE=

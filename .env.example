OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GEMINI_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=

# Embeddings, vector store, and real-time knowledge: configure the chosen path.
OPENAI_EMBEDDING_MODEL=
CHROMA_PERSIST_DIR=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
TAVILY_API_KEY=

# Deployment: configure during final integration.
# Initial requests are self-contained; durable conversation state is not selected.
